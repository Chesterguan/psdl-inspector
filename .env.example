# PSDL Inspector Environment Configuration
# Copy this file to .env and fill in your values

# ===================
# LLM Configuration
# ===================

# OpenAI API Key (for AI-assisted scenario generation)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Ollama Host (for local LLM, default: http://localhost:11434)
# If using Docker, use: http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434

# ===================
# Vocabulary Search (Optional)
# ===================

# Embedder: minilm (default), sapbert, biolord, openai
VOCAB_SEARCH_EMBEDDER=minilm

# Retriever: faiss (default), numpy, hnsw
VOCAB_SEARCH_RETRIEVER=faiss

# Reranker: rules (default), none, string, hybrid
VOCAB_SEARCH_RERANKER=rules

# ===================
# Frontend (for Docker deployment)
# ===================

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8200
